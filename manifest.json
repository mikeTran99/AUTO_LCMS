{
  "manifest_version": 3,
  "name": "Auto LCMS Quiz Solver — Stealth Edition",
  "version": "2.2.0",
  "description": "Chụp màn hình quiz → Giải bằng AI → Tự động điền đáp án stealth chính xác nhất có thể. Tương thích Chrome, Edge, Brave, Cốc Cốc, Opera.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "*://*.ntt.edu.vn/*",
    "*://*/mod/quiz/*",
    "*://*/*attempt.php*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ntt.edu.vn/*",
        "*://*/mod/quiz/*",
        "*://*/*attempt.php*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "commands": {
    "toggle-autofill-panel": {
      "suggested_key": {
        "default": "Alt+A",
        "windows": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "Bật/Tắt bảng điều khiển Auto LCMS"
    }
  }
}
